# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server and database configuration
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=receipts
SUPABASE_SERVICE_ROLE_KEY=

# Local-only demonstration behavior. Keep false in production.
DEMO_MODE=false

# Local or CI E2E only. Never configure these as public browser variables.
E2E_DEMO_EMAIL=
E2E_DEMO_PASSWORD=

# Comma separated emails allowed to use the admin console. Empty disables it.
ADMIN_EMAILS=
